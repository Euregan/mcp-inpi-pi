{
  "name": "@guix77/mcp-inpi-pi",
  "version": "0.1.0",
  "description": "Serveur MCP pour la recherche de marques françaises via l'API INPI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-inpi-pi": "dist/index.js",
    "mcp-inpi-pi-http": "dist/index-http.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/index-http.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "keywords": [
    "mcp",
    "inpi",
    "marques",
    "trademarks",
    "propriete-industrielle",
    "model-context-protocol"
  ],
  "author": "Guillaume Duveau <guillaume.duveau@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guix77/mcp-inpi-pi.git"
  },
  "homepage": "https://github.com/guix77/mcp-inpi-pi#readme",
  "bugs": {
    "url": "https://github.com/guix77/mcp-inpi-pi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "volta": {
    "node": "24.14.1",
    "npm": "11.12.1"
  }
}
